{
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Shortformer LM Eval (WikiText-103)",
            "type": "debugpy",
            "python": "/opt/conda/envs/shortformer/bin/python",
            "request": "launch",
            "program": "fairseq_cli/eval_lm.py",
            "console": "integratedTerminal",
            "args": [
                "data/wikitext-103",
                "--path", "checkpoints/shortformer/model.pt",
                "--sample-break-mode", "none",
                "--gen-subset", "test",
                "--max-sentences", "1",
                "--save-layers", "-1",
                "--save-probs",
                "--results-path", "checkpoints/shortformer/results"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python Debugger: Traing Shortformer with Temp",
            "type": "debugpy",
            "python": "/opt/conda/envs/shortformer/bin/python",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "args": [
                "data/wikitext-103",
                "--task", "language_modeling",
                "--save-dir", "checkpoints/shortformer_temp/",
                "--arch", "transformer_lm_wiki103",
                "--max-update", "140100",
                "--max-lr", "1.0",
                "--t-mult", "2",
                "--lr-period-updates", "270000",
                "--lr-scheduler", "cosine",
                "--lr-shrink", "0.75",
                "--warmup-updates", "16000",
                "--warmup-init-lr", "1e-07",
                "--min-lr", "1e-09",
                "--optimizer", "nag",
                "--lr", "0.0001",
                "--clip-norm", "0.1",
                "--criterion", "adaptive_loss",
                "--max-tokens", "9216",
                "--update-freq", "1",
                "--seed", "1",
                "--sample-break-mode", "none",
                "--skip-invalid-size-inputs-valid-test",
                "--ddp-backend", "no_c10d",
                "--tokens-per-sample", "128",
                "--max-tokens-valid", "128",
                "--tokens-from-prev", "128",
                "--curriculum", "1000",
                "--required-batch-size-multiple", "1",
                "--save-interval", "100",
                "--temp-degree", "1",
                "--temp-pieces", "10",
                "--fixed-thresholds"
            ],
            "cwd": "${workspaceFolder}"
        },
    ]
}